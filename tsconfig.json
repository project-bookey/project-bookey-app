{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@bookey/api-types": [
        "../packages/api-types/src/index.ts"
      ]
    },
    "types": [
      "node",
      "expo"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../packages/api-types/src/**/*.ts"
  ]
}
