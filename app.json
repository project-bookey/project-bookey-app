{
  "expo": {
    "name": "Bookey",
    "slug": "bookey",
    "scheme": "bookey",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F4EF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.bookey.mobile",
      "buildNumber": "1",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#F7F4EF"
      },
      "package": "app.bookey.mobile",
      "versionCode": 1,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "독후감과 모임 읽기로그에 붙일 사진을 고르기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": "모임 읽기로그에 남길 조각을 찍기 위해 카메라에 접근합니다.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#70E0B5",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://api.bookey.site",
      "router": {},
      "eas": {
        "projectId": "a70b0194-a7e3-47c2-828f-71e2a37f3bef"
      }
    },
    "owner": "jaygamo"
  }
}
