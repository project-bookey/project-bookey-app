{
  "expo": {
    "name": "Bookey",
    "slug": "bookey",
    "scheme": "bookey",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F4EF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.bookey.mobile",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "EXExpoAppSceneDelegate"
              }
            ]
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#F7F4EF"
      },
      "package": "app.bookey.mobile",
      "versionCode": 1,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진, 독후감, 클럽 메모, 모임 노트, 문의에 붙일 사진을 고를 때 사진 보관함을 써요.",
          "cameraPermission": "클럽에 남길 메모 사진을 찍을 때 카메라를 써요.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#3ddc97",
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-iap"
    ],
    "extra": {
      "apiBaseUrl": "https://api.bookey.site",
      "router": {},
      "eas": {
        "projectId": "a70b0194-a7e3-47c2-828f-71e2a37f3bef"
      }
    },
    "owner": "jaygamo"
  }
}
