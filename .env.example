# Public values bundled into the mobile app. Never put client secrets here.
EXPO_PUBLIC_API_URL=https://api.bookey.site
EXPO_PUBLIC_ENABLE_PAYMENTS=false

# Google OAuth client IDs created for each application type.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Kakao REST API key. Kakao login requires a development/production build.
EXPO_PUBLIC_KAKAO_REST_KEY=
