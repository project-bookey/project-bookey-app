# Public values bundled into the mobile app. Never put client secrets here.
EXPO_PUBLIC_API_URL=https://api.bookey.site
EXPO_PUBLIC_ENABLE_PAYMENTS=false
EXPO_PUBLIC_SUBSCRIPTION_PRODUCT_ID=bookey.plus.monthly
# Development-only: accept the local Xcode StoreKit callback without server verification.
EXPO_PUBLIC_LOCAL_STOREKIT_TEST=false

# Google OAuth client IDs created for each application type.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Kakao login needs no app key: the backend holds it and relays the OAuth flow (KAKAO_LOGIN_* on the server).
# The app must receive the bookey:// redirect: iOS (Expo Go included) or an Android development/production build — not Android Expo Go or web.
